# GitHub API (Required)
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_repository_name

# OpenRouter API (Required)
# Get your free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# OpenRouter Model Configuration
# Popular free/low-cost models:
# - meta-llama/llama-3.1-70b-instruct (recommended, powerful)
# - meta-llama/llama-3.1-8b-instruct (faster, lighter)
# - mistralai/mistral-7b-instruct (good performance)
# - google/gemma-7b-it (Google's free model)
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4000

# Workspace configuration
WORKSPACE_DIR=./workspace
